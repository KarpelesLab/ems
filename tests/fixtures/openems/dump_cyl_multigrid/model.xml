      <ZLines>0,1,2,3,4,5,6</ZLines>
    </RectilinearGrid>
    <Properties>
      <Excitation Name="exc" Type="0" Excite="0,0,1">
        <Primitives><Box Priority="0"><P1 X="3" Y="0.523598775598299" Z="2"/><P2 X="3" Y="0.523598775598299" Z="4"/></Box></Primitives>
      </Excitation>
