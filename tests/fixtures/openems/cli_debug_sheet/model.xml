<!-- ems command-line fixture "cli_debug_sheet": the operator dump of openEMS's ConductingSheet
     model on a graded Cartesian mesh: a copper pentagon with oblique sides (z plane), a resistive
     box sheet with borders off the mesh lines (x plane) cut by a dielectric and a metal block of
     higher priority, and a sheet reaching the lower mesh boundary (y plane), without simulation.
     Hand-written for the black-box openEMS oracle (scripts/openems-oracle/gen-cli.sh). -->
<openEMS>
  <FDTD NumberOfTimesteps="400" endCriteria="1e-3" TimeStep="9e-13">
    <Excitation Type="0" f0="4e9" fc="4e9"/>
    <BoundaryCond xmin="PEC" xmax="PEC" ymin="PEC" ymax="PEC" zmin="PEC" zmax="PEC"/>
  </FDTD>
  <ContinuousStructure CoordSystem="0">
    <RectilinearGrid DeltaUnit="1e-3" CoordSystem="0">
      <XLines>0,0.6,1.5,2.5,3.2,4,5,6.1,7,8,8.7,9.5,10.5,12</XLines>
      <YLines>0,0.4,1.2,2,3,3.6,4.5,5.5,6.6,7.4,8.4,9.2,10.4,11.2,12</YLines>
      <ZLines>0,0.7,1.6,2.4,3.5,4.3,5,6,6.8,7.6,8.7,9.8,10.6,12</ZLines>
    </RectilinearGrid>
    <Properties>
      <Excitation Name="exc" Type="0" Excite="0,0,1">
        <Primitives><Box Priority="0"><P1 X="1.5" Y="2" Z="1.6"/><P2 X="1.5" Y="2" Z="3.5"/></Box></Primitives>
      </Excitation>
      <ConductingSheet Name="penta" Conductivity="5.8e7" Thickness="3.5e-5">
        <Primitives><Polygon Priority="0" NormDir="2" Elevation="10.6" QtyVertices="5"><Vertex X1="2.13" X2="3.07"/><Vertex X1="9.41" X2="1.88"/><Vertex X1="10.96" X2="7.23"/><Vertex X1="6.37" X2="10.71"/><Vertex X1="1.32" X2="8.04"/></Polygon></Primitives>
      </ConductingSheet>
      <ConductingSheet Name="plate" Conductivity="1000" Thickness="1e-4">
        <Primitives><Box Priority="0"><P1 X="8" Y="1.7" Z="1.1"/><P2 X="8" Y="10.1" Z="9.3"/></Box></Primitives>
      </ConductingSheet>
      <ConductingSheet Name="floor" Conductivity="1e5" Thickness="2e-5">
        <Primitives><Box Priority="0"><P1 X="0" Y="9.2" Z="0"/><P2 X="5.3" Y="9.2" Z="4.6"/></Box></Primitives>
      </ConductingSheet>
      <Material Name="diel"><Property Epsilon="3.5" Kappa="0.02"/>
        <Primitives><Box Priority="5"><P1 X="7" Y="6.6" Z="6.8"/><P2 X="9.5" Y="9.2" Z="9.8"/></Box></Primitives>
      </Material>
      <Metal Name="pec">
        <Primitives><Box Priority="5"><P1 X="7" Y="2" Z="2.4"/><P2 X="9.5" Y="3.6" Z="4.3"/></Box></Primitives>
      </Metal>
    </Properties>
  </ContinuousStructure>
</openEMS>
